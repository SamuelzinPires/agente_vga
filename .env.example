# ─── IA (pelo menos uma das duas) ──────────────────────────────────────────
# Principal: chave da API do Gemini, gerada em https://aistudio.google.com/apikey
# ATENCAO: a assinatura Google AI Plus/Pro de estudante NAO da chave de API.
# A chave sai do AI Studio e tem free tier proprio.
GEMINI_API_KEY=
# Fallback automatico quando a cota do Gemini estourar: https://console.groq.com/keys
GROQ_API_KEY=

# ─── Banco de dados (dedupe + historico) ───────────────────────────────────
# https://supabase.com/dashboard -> Project Settings -> API
SUPABASE_URL=
SUPABASE_KEY=

# ─── Notificacao ───────────────────────────────────────────────────────────
# Bot criado no @BotFather; chat id obtido em @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Ajustes opcionais (tem default no codigo) ─────────────────────────────
# SCORE_MINIMO=60
# SCORE_FORTE=75
# MAX_VAGAS_POR_RODADA=30
# PAUSA_ENTRE_VAGAS=4
# GEMINI_MODEL=gemini-3.5-flash
# GROQ_MODEL=openai/gpt-oss-120b
